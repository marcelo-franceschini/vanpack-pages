{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanpack.local/schemas/diferenciais.schema.json",
  "title": "Diferenciais",
  "description": "Os cartões da seção \"Por que a Vanpack\" (até 6). Sem nenhum, a seção e os links para ela somem.",
  "type": "object",
  "additionalProperties": false,
  "required": ["itens"],
  "properties": {
    "itens": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titulo"],
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Título do diferencial."
          },
          "texto": {
            "type": "string",
            "maxLength": 160,
            "description": "Explicação curta. Vazio: o cartão fica só com o título."
          },
          "icone": {
            "enum": ["fabrica", "lotes", "conversa", "caixa"],
            "description": "Ícone do cartão. Vazio: sem ícone."
          }
        }
      }
    }
  }
}
