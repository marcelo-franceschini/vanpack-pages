{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanpack.local/schemas/produtos.schema.json",
  "title": "Produtos",
  "description": "Os produtos da seção \"O que fabricamos\". Cada um tem um 3D girando no topo do cartão e um botão de orçamento.",
  "type": "object",
  "additionalProperties": false,
  "required": ["etiqueta", "titulo", "fatos", "botao", "itens"],
  "properties": {
    "etiqueta": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "description": "Linha pequena acima do título da seção."
    },
    "titulo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 55,
      "description": "Título da seção."
    },
    "fatos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pedido_minimo", "regiao"],
      "description": "Os dois dados operacionais acima dos cartões. Cada um some se não houver dado em content/empresa.yaml.",
      "properties": {
        "pedido_minimo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rotulo", "valor"],
          "properties": {
            "rotulo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 25,
              "description": "Rótulo."
            },
            "valor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "Valor."
            }
          }
        },
        "regiao": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rotulo", "valor"],
          "properties": {
            "rotulo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 21,
              "description": "Rótulo."
            },
            "valor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 22,
              "description": "Valor."
            }
          }
        }
      }
    },
    "botao": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45,
      "description": "Texto do botão de orçamento de cada cartão."
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "Um cartão por produto, na ordem em que aparecem. O 3D de cada um é uma peça pronta (corte-e-vinco, divisorias ou chapas): não dá para criar um produto novo só por aqui.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome", "mensagem", "peca", "texto"],
        "properties": {
          "id": {
            "enum": ["corte-e-vinco", "divisorias", "chapas"],
            "description": "Qual peça 3D e qual ilustração o cartão usa. Também vira o código de origem do botão: [site-produtos-<id>]."
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Título do cartão."
          },
          "mensagem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Mensagem pronta do botão de orçamento deste produto (o site acrescenta o código de origem no fim)."
          },
          "peca": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Descrição da peça para leitor de tela (\"Modelo 3D de <peca> girando\")."
          },
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "description": "Descrição do produto no cartão."
          }
        }
      }
    }
  }
}
