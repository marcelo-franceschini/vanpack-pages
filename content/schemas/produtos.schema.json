{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanpack.local/schemas/produtos.schema.json",
  "title": "Produtos",
  "description": "Os produtos da seção \"O que fabricamos\". Cada um tem um modelo 3D interativo, especificações técnicas e botão de orçamento.",
  "type": "object",
  "additionalProperties": false,
  "required": ["titulo", "botao", "itens"],
  "properties": {
    "titulo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 55,
      "description": "Título da seção."
    },
    "botao": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45,
      "description": "Texto do botão de orçamento de cada cartão."
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome", "mensagem", "peca", "texto"],
        "properties": {
          "id": {
            "enum": ["corte-e-vinco", "divisorias", "chapas", "caixa-normal"]
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "mensagem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "peca": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "especificacoes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    }
  }
}
