{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "noImplicitAny": false,
    "strict": false,
    "types": []
  },
  "include": ["src/**/*.js", "src/types.d.ts"],
  "exclude": ["node_modules", "dist*"]
}
