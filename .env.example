# Dados da empresa: a fonte única do site (rodapé, JSON-LD, links do WhatsApp, FAQ, robots e sitemap).
# Este arquivo guarda os valores FICTÍCIOS de demonstração e serve de referência para o build: em
# production, o build falha se algum valor fictício sobrar no `.env`. Para ir ao ar com dados reais,
# edite só o `.env` (passo a passo em docs/go-live.md).
# Valor vazio = sem dado: o trecho correspondente some da página (nada é inventado).
# Nada aqui é segredo: tudo vai para o HTML público.

# Modo dos dados: "demo" (dados fictícios; o site sai com noindex e robots bloqueando tudo) ou
# "production" (exige dado real e completo; indexável).
VITE_DATA_MODE=demo

# Endereço público do site, terminando em "/" (canonical, og:url, og:image, JSON-LD, robots, sitemap).
VITE_SITE_URL=https://marcelo-franceschini.github.io/vanpack-pages/

# WhatsApp que recebe os pedidos de orçamento: 55 + DDD + número (ex.: 5511912345678). Obrigatório.
VITE_WHATSAPP=5511900000000

# Telefone para ligações (formato +55 + DDD + número) e o texto que aparece na página.
VITE_PHONE=+551130000000
VITE_PHONE_DISPLAY="(11) 3000-0000"

# E-mail de contato (use um com o domínio da empresa).
VITE_EMAIL=contato@exemplo.com.br

# CNPJ e razão social, como aparecem no rodapé e no JSON-LD.
VITE_CNPJ=00.000.000/0001-00
VITE_LEGAL_NAME="Vanpack Embalagens Demonstração LTDA"

# Endereço da fábrica.
VITE_STREET="Rua Exemplo, 123"
VITE_DISTRICT="Bairro Demonstração"
VITE_CITY="Santo André"
VITE_STATE=SP
VITE_CEP=00000-000

# Horário de atendimento: o texto do rodapé e o formato do schema.org (Mo-Fr 08:00-17:00).
VITE_HOURS="Seg a Sex, 8h às 17h"
VITE_HOURS_SCHEMA="Mo-Fr 08:00-17:00"

# Link do mapa (Google Maps) para o endereço.
VITE_MAP_URL=https://maps.google.com/?q=Santo+Andre+SP

# Ano de fundação. O "N anos de mercado" da página é calculado a partir dele, sem edição anual.
VITE_FOUNDED_YEAR=2010

# Dados operacionais (aparecem em produtos, FAQ e chamadas): pedido mínimo em unidades, prazo em dias
# úteis, região atendida e formas de pagamento.
VITE_MIN_ORDER=500
VITE_LEAD_TIME_DAYS=10
VITE_SERVICE_AREA="Santo André, ABC e Grande São Paulo"
VITE_PAYMENT_METHODS="Pix, boleto faturado e cartão"

# Horário do assistente (chatbot) do WhatsApp: entra na linha de risco ("Resposta na hora, 24 horas")
# e no rodapé. Vazio = a página não promete resposta na hora. É real desde já (não é fictício).
VITE_WHATSAPP_HOURS="24 horas"

# Medição sem cookies no Umami Cloud: provedor ("umami" ou vazio), Website ID do site lá e, só para
# instância própria, o endereço base do servidor. Vazio = sem medição (eventos só no dataLayer).
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_SITE=
VITE_ANALYTICS_ENDPOINT=
