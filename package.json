{
  "name": "vanpack-pages",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page da Vanpack Embalagens com a animação 3D da linha de produção de caixas.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:audit": "vite build --mode audit --outDir dist-audit",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.pagina.json",
    "test": "npm run build && npm run build:audit && node --test --test-concurrency=1 tests/*.test.mjs",
    "audit:bundle": "node scripts/audit/bundle.mjs",
    "audit:scene": "node scripts/audit/scene-stats.mjs",
    "audit:runtime": "node scripts/audit/runtime.mjs",
    "audit:lighthouse": "node scripts/audit/lighthouse.mjs",
    "audit:capturas": "node scripts/audit/capturas.mjs",
    "audit:produtos": "node scripts/audit/produtos-stats.mjs",
    "audit:paridade": "node scripts/audit/paridade.mjs",
    "og": "node scripts/og.mjs",
    "amostra": "node scripts/amostra.mjs"
  },
  "dependencies": {
    "three": "0.184.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  }
}
