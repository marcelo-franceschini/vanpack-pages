{
  "name": "vanpack-pages",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page da Vanpack Embalagens com a animação 3D da linha de produção de caixas.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npx --yes tsx --test tests/*.test.ts",
    "og": "node tools/assets/og.mjs",
    "icons": "node tools/assets/icons.mjs"
  },
  "dependencies": {
    "three": "0.184.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.187.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  }
}
