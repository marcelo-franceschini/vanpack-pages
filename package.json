{
  "name": "vanpack-pages",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page da Vanpack Embalagens com a animação 3D da linha de produção de caixas.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:audit": "vite build --mode audit --outDir dist-audit",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && npm run build:audit && node --test --test-concurrency=1 tests/*.test.mjs",
    "audit:bundle": "node scripts/audit/bundle.mjs",
    "audit:scene": "node scripts/audit/scene-stats.mjs",
    "audit:runtime": "node scripts/audit/runtime.mjs",
    "audit:lighthouse": "node scripts/audit/lighthouse.mjs",
    "audit:capturas": "node scripts/audit/capturas.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "three": "0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
